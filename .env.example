# Configuración de Entorno — SubRuta (Ideathon NEA Tech 2026)
# Copiá este archivo como ".env" en la raíz del proyecto.
# Si dejás DATABASE_URL vacío, Django usará automáticamente la base local SQLite con los datos del NEA precargados (Plan B anti-cortes de Wi-Fi).

DEBUG=True
SECRET_KEY=ideathon-nea-tech-2026-subruta-secret-key

# --- CONEXIÓN A SUPABASE (PostgreSQL en la nube) ---
# En Supabase -> Project Settings -> Database -> Connection String (URI / Transaction Pooler port 6543 o 5432):
# Ejemplo: postgresql://postgres.[PROJECT-REF]:[TU-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Opcional: API REST de Supabase si desean consultar directo desde JS
SUPABASE_URL=
SUPABASE_ANON_KEY=
