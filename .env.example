# Configuración de Entorno — SubRuta (Ideathon NEA Tech 2026)
# 1. Copiá este archivo y renombralo como ".env" en la raíz del proyecto.
# 2. Reemplazá [PEDIR_PASSWORD_AL_EQUIPO] por la clave del proyecto en Supabase.
# (El archivo .env está en .gitignore para que la clave nunca se suba a GitHub).

DEBUG=True
SECRET_KEY=ideathon-nea-tech-2026-subruta-secret-key

# --- CONEXIÓN ACTIVA A SUPABASE (Transaction Pooler - Región São Paulo) ---
DATABASE_URL="postgresql://postgres.jgoshhspwleynatnahwr:[PEDIR_PASSWORD_AL_EQUIPO]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- MAPAS BASE CARTO (Opcional: elimina marca de agua en capa Voyager) ---
